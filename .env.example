# Copy to .env for local development. Never commit .env.
# On Railway, set these as service variables instead.

# --- Shared ------------------------------------------------------------------
ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO

# --- Clerk (https://dashboard.clerk.com > API keys) ----------------------------
# Web
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# API: the Frontend API URL shown in Clerk (no trailing slash)
CLERK_ISSUER=https://your-app.clerk.accounts.dev
# JSON list of origins allowed to present tokens (the web app's URL)
CLERK_AUTHORIZED_PARTIES=["http://localhost:3000"]
# Clerk > Webhooks > endpoint https://api.yourdomain.com/v1/webhooks/clerk
CLERK_WEBHOOK_SECRET=whsec_xxx

# --- API / worker ----------------------------------------------------------------
# App role: non-superuser, RLS enforced. See infra/postgres/create_app_role.sql.
DATABASE_URL=postgresql://sqa_app:sqa_app_dev@localhost:5432/sqa
# Owner role: used only by `alembic upgrade head`.
DATABASE_URL_MIGRATIONS=postgresql://postgres:postgres@localhost:5432/sqa
DB_APP_ROLE=sqa_app
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:3000"]
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# --- Web --------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Demo workspace (optional) ------------------------------------------------------
# "Try the demo" signs visitors into one shared, seeded demo org without Clerk.
# Set the SAME secret on web and api (32+ chars): python -c "import secrets;print(secrets.token_urlsafe(48))"
# The API pins every demo token to the demo org, so it can't reach real customers.
NEXT_PUBLIC_DEMO_MODE=0
DEMO_JWT_SECRET=
# Local dev without Redis: REDIS_URL=memory:// (refused in production)

# --- Documents (Phase 1b) -------------------------------------------------------
# Jobs: "arq" (worker via Redis) or "inline" (runs in the request; dev/tests only).
QUEUE_BACKEND=arq
# Storage: "s3" (Cloudflare R2 / AWS S3 / MinIO) or "local" (dev only).
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=.data/storage
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=sqa-documents
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# R2 encrypts every object at rest already: set S3_SSE= (empty). AWS S3: AES256.
# S3_SSE=AES256
SIGNED_URL_TTL_SECONDS=300
# Base URL browsers use to reach the API (local-storage download links).
PUBLIC_API_URL=http://localhost:8000
MAX_UPLOAD_BYTES=52428800
MAX_DOCUMENT_PAGES=2000
MAX_SPREADSHEET_ROWS=50000
# DOCX page numbers: "auto" uses LibreOffice when installed (it is in the worker image).
DOCX_CONVERTER=auto

# --- Embeddings ------------------------------------------------------------------
# voyage | openai (any OpenAI-compatible endpoint) | hash (local, dev only).
# Every provider is asked for 1024-dim vectors. Changing provider needs a re-embed.
EMBEDDINGS_PROVIDER=hash
EMBEDDINGS_MODEL=voyage-3.5
VOYAGE_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Allow uploads in the shared demo org (anonymous visitors). Keep off in public deployments.
DEMO_ALLOW_UPLOADS=false

# --- Search (Phase 1c) ------------------------------------------------------------
# Optional cross-encoder reranking of the top candidates: voyage | none.
# Uses VOYAGE_API_KEY. Recommended in production; Phase 2 thresholds on its score.
RERANK_PROVIDER=none
RERANK_MODEL=rerank-2.5

# --- Questionnaires (Phase 2a) ----------------------------------------------------
# Scanned PDFs and photos: "local" = PaddleOCR models via RapidOCR (CPU, offline, default),
# "claude" = optional Claude vision engine (needs ANTHROPIC_API_KEY), "none" = refuse scans.
QUESTIONNAIRE_OCR=local
MAX_OCR_PAGES=50
MAX_QUESTIONNAIRE_QUESTIONS=3000
# Optional Claude API engine; the default path uses local models only.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL_EXTRACT=claude-opus-5-5
# Seed an empty demo org with the Northwind sample documents and questionnaire.
DEMO_SEED=true

# --- Later phases (not used yet) --------------------------------------------------
# ANTHROPIC_MODEL_ANSWER=
# ANTHROPIC_MODEL_VERIFY=

# Worker image. Same code as the API plus LibreOffice, which renders DOCX to
# PDF so citations get real page numbers. Separate image so the API stays small.
# Build context: repository root.
FROM python:3.12-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
COPY --from=ghcr.io/astral-sh/uv:0.13.6 /uv /usr/local/bin/uv
WORKDIR /app

FROM base AS deps
COPY apps/api/pyproject.toml apps/api/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

FROM base AS runtime
# Liberation fonts are metric-compatible with Arial/Times/Courier, so pages
# break where they did in Word. libgl1 and libglib2.0-0: OpenCV, used by local OCR.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       libreoffice-writer-nogui fonts-liberation fonts-dejavu-core libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
# --create-home: LibreOffice needs a writable home for its profile.
RUN useradd --system --uid 10001 --create-home app
COPY --from=deps /app/.venv /app/.venv
COPY apps/api/ ./
# /data/storage: the docker-compose local-storage volume (development).
RUN uv sync --frozen --no-dev && chown -R app /app \
    && mkdir -p /data/storage && chown app /data/storage
USER app
ENV PATH="/app/.venv/bin:$PATH"
CMD ["arq", "sqa.worker.settings.WorkerSettings"]
